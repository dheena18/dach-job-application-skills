# ALLOWLIST: everything at the repo root is ignored unless listed below.
# This protects personal files (resumes, letters, notes, photos, new folders
# like CV/ or applications/) from an accidental `git add -A`.
/*
!/.gitignore
!/LICENSE
!/README.md
!/README.de.md
!/AGENTS.md
!/CLAUDE.md
!/requirements.txt
!/setup.sh
!/setup.ps1
!/skills/

# Inside skills/: never commit documents or caches, even by mistake
*.docx
*.pdf
*.doc
*.odt
*.rtf
*.pages
*.zip
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Private working folders (already covered by the allowlist, kept explicit)
Resume/
job-resume/
output/
.env
.env.*
